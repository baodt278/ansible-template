#!/usr/bin/env bash
# {{ ansible_managed }}
# Tạo CA nội bộ và chứng chỉ Vault ngay trên máy (khóa riêng không rời máy). Chạy lại an toàn: chỉ tạo khi thiếu.
# Gia hạn: xóa {{ tls_dir }}/vault.crt rồi chạy lại cài đặt (CA giữ nguyên, bên kết nối không phải đổi ca.crt).
set -euo pipefail
umask 077
D='{{ tls_dir }}'
install -d -m 0750 -o root -g '{{ service_group }}' "$D"
if [ ! -s "$D/ca.key" ] || [ ! -s "$D/ca.crt" ]; then
  openssl genrsa -out "$D/ca.key" 4096 2>/dev/null
  openssl req -x509 -new -key "$D/ca.key" -sha256 -days '{{ vault_ca_days }}' \
    -subj '/O={{ vault_cluster_name }}/CN={{ vault_cluster_name }} Vault internal CA' -out "$D/ca.crt"
  rm -f "$D/vault.crt"
  echo "tls: đã tạo CA nội bộ"
fi
if [ ! -s "$D/vault.crt" ] || [ ! -s "$D/vault.key" ] || ! openssl x509 -checkend 2592000 -noout -in "$D/vault.crt" >/dev/null; then
  cat > "$D/vault.ext" <<'EXT'
basicConstraints=CA:FALSE
keyUsage=digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth
subjectAltName=IP:{{ vault_ip }},IP:127.0.0.1,DNS:localhost{{ (',DNS:' ~ vault_hostname) if vault_hostname else '' }}
EXT
  openssl genrsa -out "$D/vault.key" 2048 2>/dev/null
  openssl req -new -key "$D/vault.key" -subj '/O={{ vault_cluster_name }}/CN={{ vault_hostname or vault_ip }}' -out "$D/vault.csr"
  openssl x509 -req -in "$D/vault.csr" -CA "$D/ca.crt" -CAkey "$D/ca.key" -CAcreateserial \
    -days '{{ vault_cert_days }}' -sha256 -extfile "$D/vault.ext" -out "$D/vault.crt" 2>/dev/null
  rm -f "$D/vault.csr"
  echo "tls: đã tạo chứng chỉ Vault (SAN IP:{{ vault_ip }}, IP:127.0.0.1{{ (', DNS:' ~ vault_hostname) if vault_hostname else '' }})"
fi
chown root:root "$D/ca.key"; chmod 0600 "$D/ca.key"
chown root:'{{ service_group }}' "$D/ca.crt" "$D/vault.crt" "$D/vault.key"
chmod 0644 "$D/ca.crt" "$D/vault.crt"; chmod 0640 "$D/vault.key"
openssl verify -CAfile "$D/ca.crt" "$D/vault.crt" >/dev/null
