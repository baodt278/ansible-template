# {{ ansible_managed }}
global_defs {
    router_id {{ inventory_hostname }}
    script_user root
    enable_script_security
}

vrrp_script chk_haproxy {
    script "/usr/bin/systemctl is-active --quiet haproxy"
    interval 2
    timeout 3
    rise 2
    fall 2
    # Âm và lớn hơn chênh lệch độ ưu tiên ({{ haproxy_vrrp_priority_active }} - {{ haproxy_vrrp_priority_standby }}): HAProxy chết là VIP chuyển máy.
    weight {{ haproxy_vrrp_check_weight }}
}

vrrp_instance HAPROXY_VIP {
    state {{ 'MASTER' if role == 'active' else 'BACKUP' }}
    interface {{ haproxy_vip_interface }}
    virtual_router_id {{ haproxy_vrrp_router_id }}
    priority {{ haproxy_vrrp_priority_active if role == 'active' else haproxy_vrrp_priority_standby }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass {{ haproxy_vrrp_auth_pass }}
    }
    unicast_src_ip {{ haproxy_ip }}
    unicast_peer {
{% for host in groups['haproxy'] if host != inventory_hostname %}
        {{ hostvars[host].haproxy_ip }}
{% endfor %}
    }
    virtual_ipaddress {
        {{ haproxy_vip }}/{{ haproxy_vip_prefix }} dev {{ haproxy_vip_interface }}
    }
    track_script {
        chk_haproxy
    }
}
