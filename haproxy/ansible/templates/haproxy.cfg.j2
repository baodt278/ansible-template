# {{ ansible_managed }}
# Cổng vào từ Internet → Ingress cụm VKE. Chế độ TLS: {{ haproxy_tls_mode }}.

global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    maxconn {{ haproxy_maxconn }}
    tune.bufsize {{ haproxy_tune_bufsize }}

    # TLS: chỉ TLS 1.2+, bộ mã theo Mozilla "intermediate"
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
    log global
    mode http
    option httplog
    option dontlognull
    option http-keep-alive
    timeout connect {{ haproxy_timeout_connect }}
    timeout client {{ haproxy_timeout_client }}
    timeout server {{ haproxy_timeout_server }}
    timeout http-request {{ haproxy_timeout_http_request }}
    timeout http-keep-alive {{ haproxy_timeout_http_keep_alive }}
    timeout queue {{ haproxy_timeout_queue }}
    timeout tunnel {{ haproxy_timeout_tunnel }}
    errorfile 400 /etc/haproxy/errors/400.http
    errorfile 403 /etc/haproxy/errors/403.http
    errorfile 408 /etc/haproxy/errors/408.http
    errorfile 500 /etc/haproxy/errors/500.http
    errorfile 502 /etc/haproxy/errors/502.http
    errorfile 503 /etc/haproxy/errors/503.http
    errorfile 504 /etc/haproxy/errors/504.http

# ---------------------------------------------------------------------------
# Thống kê + Prometheus — chỉ IP nội bộ của máy, có mật khẩu
# ---------------------------------------------------------------------------
frontend stats
    bind {{ haproxy_ip }}:{{ haproxy_stats_port }}
    mode http
    http-request auth realm haproxy-stats unless { http_auth(stats_users) }
    http-request use-service prometheus-exporter if { path /metrics }
    stats enable
    stats uri /stats
    stats refresh 10s
    stats hide-version
    http-request set-log-level silent

userlist stats_users
    # Mật khẩu băm SHA-512 crypt (tạo trên máy đích bằng openssl, muối cố định để chạy lại không đổi tệp)
    user {{ haproxy_stats_user }} password {{ haproxy_stats_password_hash }}

{% if haproxy_tls_mode == 'terminate' %}
# ---------------------------------------------------------------------------
# HTTP → HTTPS
# ---------------------------------------------------------------------------
frontend fe_http
    bind {{ haproxy_bind_address }}:{{ haproxy_http_port }}
    mode http
    http-request redirect scheme https code 301

# ---------------------------------------------------------------------------
# HTTPS (TLS kết thúc ở HAProxy)
# ---------------------------------------------------------------------------
frontend fe_https
    bind {{ haproxy_bind_address }}:{{ haproxy_https_port }} ssl crt {{ cert_file }} alpn h2,http/1.1
    mode http
    option forwardfor

{% if haproxy_rate_limit_enabled %}
    stick-table type ip size 200k expire 30s store http_req_rate(10s)
    http-request track-sc0 src
    http-request deny deny_status 429 if { sc_http_req_rate(0) gt {{ haproxy_rate_limit_per_10s }} }
{% endif %}

    # Không cho trình duyệt giả tiêu đề chuyển tiếp; Keycloak (sslRequired=external, KC_PROXY_HEADERS=xforwarded)
    # và API (forward-headers-strategy: framework) dựa vào các tiêu đề này để dựng địa chỉ chuyển hướng.
    # X-Forwarded-For: xóa giá trị client gửi, option forwardfor gắn lại IP thật (chống giả IP trong nhật ký/giới hạn).
    http-request del-header Forwarded
    http-request del-header X-Forwarded-For
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Host %[req.hdr(host)]
    http-request set-header X-Forwarded-Port {{ haproxy_https_port }}
    http-request set-header X-Real-IP %[src]

    # Trang quản trị Keycloak, realm master: không mở ra Internet (quản trị qua Bastion/đường hầm)
{% for prefix in haproxy_blocked_path_prefixes %}
    acl blocked_path path {{ prefix }} -m str
    acl blocked_path path_beg {{ prefix }}/
{% endfor %}
    http-request deny deny_status 404 if blocked_path

    # Tiêu đề bảo mật (ATTT): giữ giá trị riêng nếu API/Keycloak đã gửi
    http-response del-header Server
    http-response del-header X-Powered-By
    http-response set-header Strict-Transport-Security "max-age={{ haproxy_hsts_max_age }}"
    http-response set-header X-Content-Type-Options nosniff if !{ res.hdr(X-Content-Type-Options) -m found }
    http-response set-header Referrer-Policy strict-origin-when-cross-origin if !{ res.hdr(Referrer-Policy) -m found }
    http-response set-header X-Frame-Options SAMEORIGIN if !{ res.hdr(X-Frame-Options) -m found }

    default_backend be_ingress

backend be_ingress
    mode http
    balance roundrobin
    option redispatch
    retries 2
{% for server in haproxy_ingress_servers %}
    server ingress{{ loop.index }} {{ server }} check {{ haproxy_ingress_check }}
{% endfor %}
{% else %}
# ---------------------------------------------------------------------------
# TLS passthrough: Ingress giữ chứng chỉ; HAProxy chỉ chuyển TCP (không thêm tiêu đề, không chặn đường dẫn).
# ---------------------------------------------------------------------------
frontend fe_http
    bind {{ haproxy_bind_address }}:{{ haproxy_http_port }}
    mode http
    http-request redirect scheme https code 301

frontend fe_https
    bind {{ haproxy_bind_address }}:{{ haproxy_https_port }}
    mode tcp
    option tcplog
    tcp-request inspect-delay 5s
    tcp-request content accept if { req_ssl_hello_type 1 }
    default_backend be_ingress

backend be_ingress
    mode tcp
    balance roundrobin
    option redispatch
    retries 2
{% for server in haproxy_ingress_servers %}
    server ingress{{ loop.index }} {{ server }} check {{ haproxy_ingress_check }}
{% endfor %}
{% endif %}
