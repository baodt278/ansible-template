# =============================================================================
# Biến môi trường cho Ansible Redis + HAProxy.
# Chép thành .env (không commit) rồi thay từng ${...} bằng giá trị thật:
#   cp .env.example .env && chmod 600 .env
# scripts/run.sh nạp .env trước khi chạy playbook; preflight dừng nếu còn biến rỗng.
# =============================================================================

# -----------------------------------------------------------------------------
# Kết nối SSH chung (máy điều khiển Ansible → máy chủ).
# Dùng `bundle` (không SSH, chép tay qua Teleport) thì để trống các biến SSH và *_SSH_HOST.
# -----------------------------------------------------------------------------
ANSIBLE_SSH_USER=${ANSIBLE_SSH_USER}
ANSIBLE_SSH_KEY_FILE=${ANSIBLE_SSH_KEY_FILE}
# Đặt true nếu sudo trên máy chủ cần mật khẩu (Ansible sẽ hỏi một lần).
ANSIBLE_BECOME_ASK_PASS=false

# -----------------------------------------------------------------------------
# Redis 7.4 + Sentinel + VIP (3 máy)
# *_SSH_HOST: địa chỉ Ansible SSH vào (dải quản trị).
# *_IP:       IP nội bộ mà ứng dụng, Sentinel, nhân bản dùng (dải dịch vụ).
# Máy 1 là master lúc cài lần đầu; sau đó Sentinel quyết định.
# -----------------------------------------------------------------------------
REDIS_1_SSH_HOST=${REDIS_1_SSH_HOST}
REDIS_1_IP=${REDIS_1_IP}
REDIS_2_SSH_HOST=${REDIS_2_SSH_HOST}
REDIS_2_IP=${REDIS_2_IP}
REDIS_3_SSH_HOST=${REDIS_3_SSH_HOST}
REDIS_3_IP=${REDIS_3_IP}

# TÙY CHỌN — để trống (REDIS_VIP=) thì không cài keepalived; ứng dụng trỏ thẳng IP master.
# Có VIP: VIP luôn nằm trên master hiện tại (keepalived theo Sentinel), ứng dụng chỉ trỏ vào VIP.
# Bốn biến dưới chỉ cần khi có VIP.
REDIS_VIP=${REDIS_VIP}
# Độ dài tiền tố mạng của VIP, ví dụ 24.
REDIS_VIP_PREFIX=${REDIS_VIP_PREFIX}
# Card mạng mang IP nội bộ (vd. ens4); xem bằng `ip -br addr` trên máy Redis.
REDIS_VIP_INTERFACE=${REDIS_VIP_INTERFACE}
# 1–255, không trùng virtual_router_id khác trong cùng mạng.
REDIS_VRRP_ROUTER_ID=${REDIS_VRRP_ROUTER_ID}
# Tối đa 8 ký tự (giới hạn của VRRP).
REDIS_VRRP_AUTH_PASS=${REDIS_VRRP_AUTH_PASS}

# Mật khẩu (nên ≥ 32 ký tự ngẫu nhiên: `openssl rand -base64 32 | tr -d '/+='`).
# Người dùng quản trị (default) — chỉ người vận hành, sao lưu, kiểm tra keepalived.
REDIS_ADMIN_PASSWORD=${REDIS_ADMIN_PASSWORD}
# Người dùng ứng dụng (API, worker BullMQ). REDIS_URL của ứng dụng:
#   redis://vtvl:<REDIS_APP_PASSWORD>@<REDIS_VIP>:6379
REDIS_APP_PASSWORD=${REDIS_APP_PASSWORD}
# Nhân bản giữa các nút Redis.
REDIS_REPL_PASSWORD=${REDIS_REPL_PASSWORD}
# Sentinel theo dõi Redis.
REDIS_SENTINEL_MONITOR_PASSWORD=${REDIS_SENTINEL_MONITOR_PASSWORD}
# Truy cập Sentinel (cổng 26379) và Sentinel xác thực lẫn nhau.
REDIS_SENTINEL_PASSWORD=${REDIS_SENTINEL_PASSWORD}
# redis_exporter (Prometheus) — chỉ đọc INFO, không đọc dữ liệu.
REDIS_EXPORTER_PASSWORD=${REDIS_EXPORTER_PASSWORD}

# -----------------------------------------------------------------------------
# HAProxy + keepalived (2 máy vùng DMZ, cổng vào Ingress cụm VKE)
# -----------------------------------------------------------------------------
HAPROXY_1_SSH_HOST=${HAPROXY_1_SSH_HOST}
HAPROXY_1_IP=${HAPROXY_1_IP}
HAPROXY_2_SSH_HOST=${HAPROXY_2_SSH_HOST}
HAPROXY_2_IP=${HAPROXY_2_IP}

# TÙY CHỌN — để trống (HAPROXY_VIP=) thì không cài keepalived, mỗi máy nhận trên IP riêng.
# Bốn biến dưới chỉ cần khi có VIP.
HAPROXY_VIP=${HAPROXY_VIP}
HAPROXY_VIP_PREFIX=${HAPROXY_VIP_PREFIX}
HAPROXY_VIP_INTERFACE=${HAPROXY_VIP_INTERFACE}
HAPROXY_VRRP_ROUTER_ID=${HAPROXY_VRRP_ROUTER_ID}
HAPROXY_VRRP_AUTH_PASS=${HAPROXY_VRRP_AUTH_PASS}

# Ingress cụm VKE: danh sách ip:cổng, cách nhau bởi dấu phẩy (IP nội bộ các nút worker + NodePort của Ingress).
# Ví dụ: 10.0.0.4:30080,10.0.0.5:30080,10.0.0.6:30080
HAPROXY_INGRESS_SERVERS=${HAPROXY_INGRESS_SERVERS}

# terminate: HAProxy giữ chứng chỉ, gắn X-Forwarded-*, chặn trang quản trị Keycloak, thêm tiêu đề bảo mật.
# passthrough: chuyển nguyên TLS vào Ingress (Ingress giữ chứng chỉ, HAProxy không thấy HTTP).
HAPROXY_TLS_MODE=terminate
# Chỉ cần khi terminate: đường dẫn TRÊN MÁY ĐIỀU KHIỂN tới tệp PEM gồm chứng chỉ + chuỗi trung gian + khóa riêng.
HAPROXY_TLS_PEM_FILE=${HAPROXY_TLS_PEM_FILE}

# Trang thống kê và /metrics (Prometheus) — chỉ nghe trên IP nội bộ của máy HAProxy.
HAPROXY_STATS_USER=${HAPROXY_STATS_USER}
HAPROXY_STATS_PASSWORD=${HAPROXY_STATS_PASSWORD}
