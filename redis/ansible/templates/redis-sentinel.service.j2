# {{ ansible_managed }}
[Unit]
Description=Redis {{ redis_version_series }} Sentinel
Documentation=https://redis.io/docs/management/sentinel/
After=network-online.target {{ redis_service_name }}.service
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/redis-server {{ sentinel_dir }}/sentinel.conf --sentinel --supervised systemd --daemonize no
TimeoutStartSec=60
TimeoutStopSec=60
Restart=always
RestartSec=2
User={{ service_user }}
Group={{ service_group }}
RuntimeDirectory=redis
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=007
LimitNOFILE=65535

NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ sentinel_dir }} {{ log_dir }} {{ run_dir }}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
