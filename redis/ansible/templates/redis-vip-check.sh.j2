#!/usr/bin/env bash
# {{ ansible_managed }}
# keepalived track_script: 0 khi máy này là master theo Sentinel cục bộ VÀ Redis cục bộ đang ROLE master.
set -u
my_ip='{{ redis_ip }}'

sentinel_master="$(REDISCLI_AUTH='{{ redis_sentinel_password }}' timeout 2 \
  redis-cli -h 127.0.0.1 -p '{{ sentinel_port }}' --no-auth-warning \
  SENTINEL get-master-addr-by-name '{{ sentinel_master_name }}' 2>/dev/null | head -n1)"
[ "${sentinel_master}" = "${my_ip}" ] || exit 1

role="$(REDISCLI_AUTH='{{ redis_admin_password }}' timeout 2 \
  redis-cli -h 127.0.0.1 -p '{{ redis_port }}' --no-auth-warning ROLE 2>/dev/null | head -n1)"
[ "${role}" = "master" ]
